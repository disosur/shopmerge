meta {
  name: Create Task (auto id)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/create-task
  body: none
  auth: none
}

tests {
  test("status is 202", function() {
    expect(res.getStatus()).to.equal(202);
  });

  test("generates a task id", function() {
    expect(res.getBody().taskId).to.match(/^task_\d+$/);
  });
}
